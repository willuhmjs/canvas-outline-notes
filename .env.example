# Canvas
CANVAS_ICS_URL=https://canvas.odu.edu/feeds/calendars/user_YOURTOKEN.ics
CANVAS_BASE_URL=https://canvas.odu.edu

# CalDAV credentials (used by Davis and the sync script)
DAV_USERNAME=will
DAV_PASSWORD=yourpassword
DAV_CALENDAR_DISPLAYNAME=Academics
DAVIS_DB_PASSWORD=changeme

# Outline (leave blank to disable AI study notes)
OUTLINE_BASE_URL=https://outline.yourserver.com
OUTLINE_API_TOKEN=ol_api_...
OUTLINE_COLLECTION_NAME=Automatic Notes

# LLM API for AI notes (OpenAI-compatible)
CHAT_API_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=sk-...
CHAT_MODEL_TEXT=gpt-4o-mini
CHAT_MODEL_VISION=gpt-4o

# Schedule overrides (optional)
# SYNC_INTERVAL_MINUTES=15
# NOTES_INTERVAL_MINUTES=60

# Optional: trust an extra CA (e.g. a self-signed intercepting proxy), without
# disabling verification for everything else. Leave unset for normal setups.
# EXTRA_CA_CERT_FILE=/extra-ca.pem

# Management app login (OIDC) — required. Register this app with your identity
# provider using redirect URI https://<host>/auth/callback/oidc
AUTH_SECRET=changeme  # generate with: openssl rand -hex 32
AUTH_OIDC_ISSUER=https://auth.example.com/application/o/canvas-management/
AUTH_OIDC_ID=your-client-id
AUTH_OIDC_SECRET=your-client-secret
# Optional: comma-separated IdP groups allowed to log in. Leave unset to allow any user.
# ALLOWED_GROUPS=admins
